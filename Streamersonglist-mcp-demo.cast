[0.000019, "o", "            \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1m\u001b[3m*An investigative report using the power of streamersonglist-mcp*\u001b[23m\u001b[22m                                           \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m---\u001b[22m\u001b[23m                                                                                                         \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m## **🎭 THE FACADE**\u001b[22m\u001b[23m                                                                                        \u001b"]
[0.000012, "o", "[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1mIn the world of Twitch music streaming, appearances can be deceiving. Meet vu_vu - a \"music streamer\" who, \u001b[23m\u001b[22m \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3mon the surface, seems to have it all together. A slick song request system, 266 songs in the catalog, \u001b[23m      \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3mactive queue management, and all the right commands to look like a legitimate musician.\u001b[23m                     \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m"]
[0.000007, "o", "│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1m\u001b[3mBut today, we're pulling back the curtain to reveal the truth: **vu_vu is a complete and utter fraud.**\u001b[22m\u001b[23m     \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1mUsing the investigative power of streamersonglist-mcp, we dug deep into the data, and what we found is \u001b[22m\u001b[23m     \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1mshocking. This isn't just someone who's bad at music - this is someone who appears to be running a \u001b[22m         \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1msophisticated deception operation.\u001b[22m                                                                          \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;"]
