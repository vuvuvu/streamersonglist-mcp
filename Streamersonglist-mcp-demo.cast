[0.000011, "o", "5;249mExit the REPL\u001b[39m\r\n  \u001b[2m/export\u001b[22m                      \u001b[2mExport the current conversation to a file or clipboard\u001b[22m\r\n  \u001b[2m/context\u001b[22m                     \u001b[2mVisualize current context usage as a colored grid\u001b[22m\r\n  \u001b[2m/voicemode:kokoro (MCP)\u001b[22m      \u001b[2mManage Kokoro text-to-speech service.\u001b[22m\r\n\r\n                               \u001b[2mArgs:\u001b[22m\r\n                               \u001b[2maction: Service action (status, start, stop, restart, enable, disable, logs) or\u001b[22m\r\n                               \u001b[2minstall request (arguments: action)\u001b[22m\r\n  \u001b[2m/clear (reset, new)\u001b[22m          \u001b[2mClear conversation history and free up context\u001b[22m\r\n  \u001b[2m/compact\u001b[22m                     \u001b[2mClear conversation history but keep a summary in context. Optional: /compact\u001b[22m\r\n                               \u001b[2m[instructions for summarization]\u001b[22m\r\n  \u001b[2m/voicemode:whisper (MCP)\u001b[22m     \u001b[2mManage Whisper speech-to-text service.\u001b[22m\r\n\r\n                               \u001b[2mArgs:\u001b[22m\r\n                      "]
