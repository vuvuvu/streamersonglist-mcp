[0.000013, "o", "2m \u001b[3m\u001b[1mOur investigation began with a simple question: What's in vu_vu's music catalog? What we uncovered using \u001b[23m\u001b[22m   \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3mstreamersonglist-mcp was a house of cards built on lies.\u001b[23m                                                    \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1m\u001b[3mLet's start with the receipts.\u001b[23m\u001b[22m                                                                              \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1m\u001b[3m---\u001b[23m\u001b[22m"]
[0.000028, "o", "                                                                                                         \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1m\u001b[3m## **💀 RECEIPT #1: THE GHOST CATALOG**\u001b[22m\u001b[23m                                                                     \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m**THE CLAIM:** vu_vu has 266 songs ready to perform for viewers.\u001b[23m\u001b[22m                                            \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                   "]
[0.000024, "o", "                                                                          \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m**THE REALITY:** Not a single song has EVER been played.\u001b[22m\u001b[23m                                                    \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1mUsing streamersonglist-mcp, we pulled the complete song catalog. Every single one of the 266 songs shows:\u001b[22m\u001b[23m   \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `timesPlayed: 0`\u001b[22m\u001b[23m                                                                                          \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `lastPlayed: null`\u001b[22m\u001b[23m           "]
[0.000023, "o", "                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m**Every. Single. Song.**\u001b[22m\u001b[23m                                                                                    \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1mFor someone who's supposedly been streaming music since September 2021, that's not just suspicious - it's \u001b[22m\u001b[23m  \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1mimpossible. Real musicians play music. vu\u001b[3m_vu apparently "]
[0.000019, "o", "doesn't.\u001b[23m\u001b[22m                                            \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1m\u001b[3m---\u001b[23m\u001b[22m                                                                                                         \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1m\u001b[3m## **🎭 RECEIPT #2: THE FAKE QUEUE**\u001b[22m\u001b[23m                                                                        \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                              "]
[0.000005, "o", "                               \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1m\u001b[3mRemember those test songs we found in vu_vu's queue? Let's talk about them.\u001b[23m\u001b[22m                                 \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m**Current Queue Analysis:**\u001b[22m\u001b[23m                                                                                 \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- Position 1: \"NOT A REAL SONG\" by KEKYou (June 2023)\u001b[22m\u001b[23m                                                       \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- Position 2: \"NOT A REAL SONG\" by KEKYou (June 2023)\u001b[22m\u001b[23m                     "]
[0.00002, "o", "                                  \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- Position 3: \"NOT A REAL SONG\" by KEKYou (June 2023)\u001b[22m\u001b[23m                                                       \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- Position 4: \"NOT A REAL SONG\" by KEKYou (June 2023)\u001b[22m\u001b[23m                                                       \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1mReal musicians don't have \"NOT A REAL SONG\" sitting in their queue for over a year. This screams \"testing\" \u001b[22m\u001b[23m \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[1mor \"setup\" - not actual streaming.\u001b[22m                                              "]
[0.000013, "o", "                            \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m---\u001b[22m\u001b[23m                                                                                                         \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m## **⚙️ RECEIPT #3: THE FRAUD CONFIGURATION**\u001b[22m\u001b[23m                                                               \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b"]
[0.000016, "o", "[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1mThis is where it gets really interesting. We compared vu_vu's settings to legitimate music streamer \u001b[23m\u001b[22m        \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3mbelleune, and the difference is night and day.\u001b[23m                                                              \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m**vu_vu (The Fraud):**\u001b[22m\u001b[23m                                                                                      \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `maxRequests: 0` (unlimited requests - ripe for abuse)\u001b[22m\u001b[23m                                                    \u001b[2m│"]
[0.000009, "o", "\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `minutesBetweenRequests: 0` (no cooldowns)\u001b[22m\u001b[23m                                                                \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `allowDuplicates: true` (doesn't care about music quality)\u001b[22m\u001b[23m                                                \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `donationsIgnoreLimits: true` (hmm, interesting...)\u001b[22m\u001b[23m                                                       \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m**belleune (Real Musician):**\u001b[22m\u001b[23m                                                                               \u001b[2m"]
[0.000007, "o", "│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `maxRequests: 30` (reasonable limits)\u001b[22m\u001b[23m                                                                     \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `minutesBetweenRequests: 120` (2-hour cooldowns)\u001b[22m\u001b[23m                                                          \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- `allowDuplicates: false` (cares about music variety)\u001b[22m\u001b[23m                                                      \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m- Actually plays music (62+ plays on top songs)\u001b[22m\u001b[23m                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b"]
[0.000022, "o", "[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1mThe configuration screams \"setup for appearance\" not \"setup for music.\"\u001b[22m\u001b[23m                                     \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m---\u001b[22m\u001b[23m                                                                                                         \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m## **📅 RECEIPT #4: THE BULK UPLOAD SCAM**\u001b[22m\u001b[23m                                                                  \u001b[2m│\u001b[22m \u001b"]
[0.000028, "o", "[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1mWant to know when all 266 songs were added to the catalog?\u001b[22m\u001b[23m                                                  \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m \u001b[3m\u001b[1m**June 12, 2023.**\u001b[22m\u001b[23m                                                                                          \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;2;177;185;249m│\u001b[39m \u001b[2m│\u001b[22m                                                                                                             \u001b[2m│\u001b[22m \u001b[38;2;177;185;249m│\u001b[39m\r\n\u001b[38;"]
