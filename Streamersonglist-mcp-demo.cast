[0.000005, "o", "\r\n\u001b[39;49m\u001b[K\u001b[2m│ directory: \u001b[22m~/Developer/mcp/streamersonglist-mcp\u001b[2m │\u001b[39m\u001b[49m\u001b[0m\r\n\u001b[39;49m\u001b[K\u001b[2m╰─────────────────────────────────────────────────╯\u001b[39m\u001b[49m\u001b[0m\r\n"]
